# Copy to .env and fill in. Never commit .env.

# AI Studio API key, created in the billed Google Cloud project
# (Nano Banana and Lyria need the paid tier).
GEMINI_API_KEY=

# Models (defaults shown; override if a model is unavailable)
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_MUSIC_MODEL=lyria-3-clip-preview
GEMINI_LIVE_MODEL=gemini-3.8-live

# AlloyDB Express connection string. Leave empty to use a local embedded
# Postgres (PGlite) in .data/ for development.
DATABASE_URL=

PORT=8080
